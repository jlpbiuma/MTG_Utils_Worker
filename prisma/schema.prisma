datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider             = "prisma-client-py"
  interface            = "asyncio"
  recursive_type_depth = 5
}

model Deck {
  id                  String     @id @default(uuid())
  userId              String     @map("user_id")
  name                String
  format              String     @default("Commander")
  description         String?
  commander           String?
  commanderScryfallId String?    @map("commander_scryfall_id")
  commanderImageUri   String?    @map("commander_image_uri")
  isArchived          Boolean    @default(false) @map("is_archived")
  tags                String?    @default("") @map("tags")
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")
  cards               DeckCard[]

  @@index([userId])
  @@map("decks")
}

model DeckCard {
  id               String  @id @default(uuid())
  deckId           String  @map("deck_id")
  cardScryfallId   String  @map("card_scryfall_id")
  cardName         String  @map("card_name")
  quantity         Int     @default(1)
  assignedQuantity Int     @default(0) @map("assigned_quantity")
  isSideboard      Boolean @default(false) @map("is_sideboard")
  isCommander      Boolean @default(false) @map("is_commander")
  manaCost         String? @map("mana_cost")
  typeLine         String? @map("type_line")
  imageUri         String? @map("image_uri")
  setCode          String? @map("set_code")
  tags             String? @default("") @map("tags")
  deck             Deck    @relation(fields: [deckId], references: [id], onDelete: Cascade)

  @@unique([deckId, cardScryfallId, isSideboard])
  @@index([deckId])
  @@index([cardScryfallId])
  @@map("deck_cards")
}

model CollectionCard {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  cardScryfallId  String   @map("card_scryfall_id")
  cardName        String   @map("card_name")
  isFoil Boolean @default(false) @map("is_foil")
  enrichmentKey String? @map("enrichment_key")
  quantity        Int      @default(1)
  setCode         String?  @map("set_code")
  collectorNumber String?  @map("collector_number")
  manaCost        String?  @map("mana_cost")
  typeLine        String?  @map("type_line")
  imageUri        String?  @map("image_uri")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, cardScryfallId, isFoil], name: "userId_cardScryfallId")
  @@index([enrichmentKey])
  @@index([userId])
  @@index([userId, cardName])
  @@map("user_collections")
}

model WantCard {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  cardScryfallId  String   @map("card_scryfall_id")
  cardName        String   @map("card_name")
  quantity        Int      @default(1)
  setCode         String?  @map("set_code")
  collectorNumber String?  @map("collector_number")
  manaCost        String?  @map("mana_cost")
  typeLine        String?  @map("type_line")
  imageUri        String?  @map("image_uri")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  @@unique([userId, cardScryfallId], name: "userId_cardScryfallId_want")
  @@index([userId])
  @@map("user_wants")
}

model CardCatalog {
  id               String    @id // Scryfall UUID
  name             String    @unique
  normalizedName   String    @unique @map("normalized_name")
  manaCost         String?   @map("mana_cost")
  typeLine         String?   @map("type_line")
  oracleTextEs     String?   @map("oracle_text_es") @db.Text
  nameEs           String?   @map("name_es")
  typeLineEs       String?   @map("type_line_es")
  flavorTextEs     String?   @map("flavor_text_es") @db.Text
  detailsEs        Json?     @map("details_es")
  detailsUpdatedAt DateTime? @map("details_updated_at")
  imageUri         String?   @map("image_uri")
  setCode          String?   @map("set_code")
  collectorNumber  String?   @map("collector_number")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")

  printings CardPrinting[]

  @@index([updatedAt])
  @@map("card_catalog")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model CardSet {
  id           String         @id
  code         String         @unique
  name         String
  setType      String         @map("set_type")
  cardCount    Int            @default(0) @map("card_count")
  releasedAt   DateTime?      @map("released_at")
  iconSvgUri   String?        @map("icon_svg_uri")
  searchUri    String         @map("search_uri")
  isDigital    Boolean        @default(false) @map("is_digital")
  isDownloaded Boolean        @default(false) @map("is_downloaded")
  downloadedAt DateTime?      @map("downloaded_at")
  downloadAttempts Int        @default(0) @map("download_attempts")
  lastAttemptAt DateTime?     @map("last_attempt_at")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  printings    CardPrinting[]

  @@map("card_sets")
}

model CardPrinting {
  id                   String    @id
  catalogId            String?   @map("catalog_id")
  setId                String    @map("set_id")
  collectorNumber      String    @map("collector_number")
  rarity               String?
  imageUri             String?   @map("image_uri")
  imageUriSmall        String?   @map("image_uri_small")
  imageUriLarge        String?   @map("image_uri_large")
  priceEur             Float?    @map("price_eur")
  priceEurFoil         Float?    @map("price_eur_foil")
  priceUsd             Float?    @map("price_usd")
  priceUsdFoil         Float?    @map("price_usd_foil")
  priceCardmarketTrend Float?    @map("price_cardmarket_trend")
  priceCardmarketMin   Float?    @map("price_cardmarket_min")
  priceCardmarketMax   Float?    @map("price_cardmarket_max")
  pricesUpdatedAt      DateTime? @map("prices_updated_at")
  releasedAt           DateTime? @map("released_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  catalog          CardCatalog?          @relation(fields: [catalogId], references: [id], onDelete: SetNull)
  set              CardSet               @relation(fields: [setId], references: [id], onDelete: Cascade)
  priceHistory     CardPriceHistory[]
  translationRetry CardTranslationRetry?

  @@unique([setId, collectorNumber])
  @@index([catalogId])
  @@index([setId])
  @@index([pricesUpdatedAt])
  @@index([updatedAt])
  @@map("card_printings")
}

model CardPriceHistory {
  id             String       @id @default(uuid())
  cardPrintingId String       @map("card_printing_id")
  provider       String       @default("cardmarket")
  currency       String       @default("EUR")
  trendPrice     Float?       @map("trend_price")
  minPrice       Float?       @map("min_price")
  maxPrice       Float?       @map("max_price")
  priceEur       Float?       @map("price_eur")
  priceEurFoil   Float?       @map("price_eur_foil")
  priceUsd       Float?       @map("price_usd")
  priceUsdFoil   Float?       @map("price_usd_foil")
  recordedAt     DateTime     @default(now()) @map("recorded_at")
  cardPrinting   CardPrinting @relation(fields: [cardPrintingId], references: [id], onDelete: Cascade)

  @@index([cardPrintingId, provider, recordedAt])
  @@map("card_price_history")
}

model CardTranslationRetry {
  cardPrintingId String       @id @map("card_printing_id")
  attempts       Int          @default(0)
  nextAttemptAt  DateTime     @map("next_attempt_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  cardPrinting   CardPrinting @relation(fields: [cardPrintingId], references: [id], onDelete: Cascade)

  @@index([nextAttemptAt])
  @@map("card_translation_retries")
}

model RuleDocument {
  id            String    @id @default(uuid())
  source        String
  format        String    @default("txt")
  url           String
  effectiveDate DateTime? @map("effective_date")
  etag          String?
  lastModified  String?   @map("last_modified")
  sha256        String
  content       String    @db.Text
  fetchedAt     DateTime  @default(now()) @map("fetched_at")

  @@unique([source, sha256])
  @@index([source, fetchedAt])
  @@map("rule_documents")
}

model RuleDocumentChange {
  id                 String  @id @default(uuid())
  previousDocumentId String? @map("previous_document_id")
  documentId         String  @map("document_id")
  ruleNumber         String  @map("rule_number")
  changeType         String  @map("change_type")
  oldText            String? @map("old_text") @db.Text
  newText            String? @map("new_text") @db.Text

  @@unique([documentId, ruleNumber])
  @@index([ruleNumber])
  @@map("rule_document_changes")
}

model CardRuling {
  id             String   @id @default(uuid())
  oracleId       String   @map("oracle_id")
  scryfallCardId String   @map("scryfall_card_id")
  source         String
  rulingDate     DateTime @map("ruling_date")
  text           String   @db.Text
  textHash       String   @map("text_hash")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")

  @@unique([oracleId, textHash])
  @@index([oracleId, rulingDate])
  @@map("card_rulings")
}

model RulingCardSync {
  scryfallCardId String   @id @map("scryfall_card_id")
  oracleId       String?  @map("oracle_id")
  lastCheckedAt  DateTime @default(now()) @map("last_checked_at")

  @@index([lastCheckedAt])
  @@map("ruling_card_sync")
}

model RulesSyncState {
  id                     String    @id @default("rules")
  rulingsCursor          String?   @map("rulings_cursor")
  lastRulesCheckAt       DateTime? @map("last_rules_check_at")
  lastRulingsFullCycleAt DateTime? @map("last_rulings_full_cycle_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  @@map("rules_sync_state")
}

model CollectionImport {
  id String @id
  userId String @map("user_id")
  requestKey String @map("request_key")
  payloadHash String @map("payload_hash")
  importedCount Int @map("imported_count")
  uniqueCards Int @map("unique_cards")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([userId, requestKey])
  @@map("collection_imports")
}

model CollectionImportItem {
  importId String @map("import_id")
  jobKey String @map("job_key")
  @@id([importId, jobKey])
  @@map("collection_import_items")
}

model EnrichmentJob {
  key String @id
  identifier Json
  status String @default("queued")
  phase String @default("resolve")
  card Json?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now()) @map("next_attempt_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token")
  lastError String? @map("last_error")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@index([status, nextAttemptAt])
  @@map("enrichment_jobs")
}

model ScryfallBulkCard {
  generation String
  id String
  nameKey String @map("name_key")
  setCode String @map("set_code")
  collectorNumber String @map("collector_number")
  lang String
  oracleId String? @map("oracle_id")
  payload Json
  @@id([generation, id])
  @@index([generation, nameKey, lang])
  @@index([generation, oracleId])
  @@index([generation, setCode, collectorNumber, lang])
  @@map("scryfall_bulk_cards")
}

model ScryfallBulkState {
  kind String @id
  generation String?
  sourceType String? @map("source_type")
  sourceUpdatedAt String? @map("source_updated_at")
  leaseUntil DateTime? @map("lease_until")
  leaseToken String? @map("lease_token")
  lastError String? @map("last_error")
  updatedAt DateTime @default(now()) @map("updated_at")
  @@map("scryfall_bulk_state")
}

model SimulatedCollection {
  id          String          @id @default(uuid())
  userId      String          @map("user_id")
  name        String
  description String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @default(now()) @updatedAt @map("updated_at")
  cards       SimulatedCard[]

  @@index([userId])
  @@map("simulated_collections")
}

model SimulatedCard {
  id                    String              @id @default(uuid())
  simulatedCollectionId String              @map("simulated_collection_id")
  cardScryfallId        String?             @map("card_scryfall_id")
  cardName              String              @map("card_name")
  quantity              Int                 @default(1)
  setCode               String?             @map("set_code")
  collectorNumber       String?             @map("collector_number")
  manaCost              String?             @map("mana_cost")
  typeLine              String?             @map("type_line")
  imageUri              String?             @map("image_uri")
  price                 Float?              @map("price")
  simulatedCollection   SimulatedCollection @relation(fields: [simulatedCollectionId], references: [id], onDelete: Cascade)

  @@index([simulatedCollectionId])
  @@map("simulated_cards")
}

model MtgjsonUuidMap {
  uuid       String @id
  scryfallId String @map("scryfall_id")

  @@index([scryfallId])
  @@map("mtgjson_uuid_map")
}

model CmPriceHistory {
  scryfallId String   @map("scryfall_id")
  finish     Int      @db.SmallInt
  date       DateTime @db.Date
  priceCents Int      @map("price_cents")

  @@id([scryfallId, date, finish])
  @@index([date])
  @@map("cm_price_history")
}

model PriceAnomaly {
  id         String   @id @default(uuid())
  scryfallId String   @map("scryfall_id")
  finish     Int      @db.SmallInt
  date       DateTime @db.Date
  priceCents Int      @map("price_cents")
  prevCents  Int      @map("prev_cents")
  detectedAt DateTime @default(now()) @map("detected_at")
  resolved   Boolean  @default(false)

  @@unique([scryfallId, finish, date])
  @@map("price_anomalies")
}

model IngestRun {
  id         Int       @id @default(autoincrement())
  sourceUrl  String?   @map("source_url")
  feedDate   String?   @map("feed_date")
  status     String    // running | success | warning | failed | skipped
  tracked    Int?
  mapped     Int?
  matched    Int?
  inserted   Int?
  invalid    Int?
  anomalies  Int?
  conflicts  Int?
  notes      String?
  error      String?
  startedAt  DateTime  @default(now()) @map("started_at")
  finishedAt DateTime? @map("finished_at")

  @@map("ingest_runs")
}

model EdhrecCommander {
  id                 String    @id
  name               String    @unique
  normalizedName     String    @unique @map("normalized_name")
  slug               String    @unique
  colorIdentity      String    @default("") @map("color_identity")
  rank               Int?
  isTop100           Boolean   @default(false) @map("is_top_100")
  numDecks           Int       @default(0) @map("num_decks")
  creatureCount      Int       @default(0) @map("creature_count")
  instantCount       Int       @default(0) @map("instant_count")
  sorceryCount       Int       @default(0) @map("sorcery_count")
  artifactCount      Int       @default(0) @map("artifact_count")
  enchantmentCount   Int       @default(0) @map("enchantment_count")
  battleCount        Int       @default(0) @map("battle_count")
  planeswalkerCount  Int       @default(0) @map("planeswalker_count")
  landCount          Int       @default(0) @map("land_count")
  basicLandCount     Int       @default(0) @map("basic_land_count")
  nonbasicLandCount  Int       @default(0) @map("nonbasic_land_count")
  cardsJson          Json?     @map("cards_json")
  canonicalCardNames Json?     @map("canonical_card_names")
  status             String    @default("pending")
  lastError          String?   @map("last_error")
  syncedAt           DateTime? @map("synced_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  @@index([isTop100])
  @@index([status])
  @@index([syncedAt])
  @@map("edhrec_commanders")
}


